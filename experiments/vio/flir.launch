<launch>
  <!-- FAST-LIVO2 on the FLIR/Ouster dataset, headless. Usage (see run_one.sh):
       roslaunch experiments/vio/flir.launch config:=... camera_yaml:=... bag:=... out_bag:=... seq_name:=... -->
  <arg name="config" />                       <!-- flir_lio.yaml or flir_livo.yaml -->
  <arg name="camera_yaml" />                  <!-- vikit camera yaml (intrinsics set under test) -->
  <arg name="bag" />
  <arg name="out_bag" />                      <!-- rosbag of the odometry topic, converted to TUM by run_one.sh -->
  <arg name="seq_name" default="flir_run" />  <!-- FAST-LIVO2 native TUM: FAST-LIVO2/Log/result/<seq_name>.txt -->
  <arg name="rate" default="1.0" />
  <arg name="start" default="0.0" />
  <arg name="play_delay" default="3.0" />
  <arg name="cam_in" default="/sensors/cam0" />            <!-- compressed topic base -->
  <arg name="img_topic" default="/sensors/cam0/image_raw" /> <!-- must equal common/img_topic in the config -->
  <arg name="odom_topic" default="/aft_mapped_to_init" />
  <arg name="rviz" default="false" />

  <param name="/use_sim_time" value="true" />
  <rosparam command="load" file="$(arg config)" />
  <param name="evo/seq_name" value="$(arg seq_name)" />

  <!-- CompressedImage -> Image for FAST-LIVO2 (subscribes sensor_msgs/Image only) -->
  <node pkg="image_transport" type="republish" name="cam0_republish" output="log"
        args="compressed in:=$(arg cam_in) raw out:=$(arg img_topic)" />

  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(arg camera_yaml)" />
  </node>

  <node pkg="rosbag" type="record" name="odom_record" output="log"
        args="-O $(arg out_bag) $(arg odom_topic)" />

  <node pkg="rosbag" type="play" name="bag_play" output="log" required="true"
        args="--clock -d $(arg play_delay) -r $(arg rate) -s $(arg start) $(arg bag)" />

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
  </group>
</launch>
